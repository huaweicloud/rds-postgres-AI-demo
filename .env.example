# Copy to .env and fill in. Every environment-specific value lives here, nowhere else.

# Supabase as seen from the server side (worker, Next.js API routes, the proxy).
# On a private network this can be the internal address of the API gateway.
SUPABASE_URL=http://supabase.internal:8000
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Public origin of the app. The proxy forwards /rest, /auth, /realtime and /storage
# on this origin to SUPABASE_URL, so the browser never needs to reach the database host.
PUBLIC_SITE_URL=http://localhost

# Any OpenAI-compatible chat completions API with JSON output.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat

# Search providers, tried in order.
SEARCH_PROVIDERS=searxng,tavily
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-openssl-rand-hex-32
TAVILY_API_KEY=

# OpenAI-compatible /v1/embeddings endpoint (Text Embeddings Inference in docker-compose).
EMBEDDINGS_URL=http://embeddings:80
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B


# Sent with every page fetch so site owners can see who is reading.
FETCH_USER_AGENT=StackDowser/0.1 (+https://github.com/huaweicloud/rds-postgres-AI-demo)

# How many agent tasks one worker process runs at once.
WORKER_CONCURRENCY=8
