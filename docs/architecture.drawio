as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;" edge="1" parent="1" source="n26" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n27" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n28" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n30" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e55" value="Postgres :5432, private" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6C8EBF;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n24" target="n31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="935"/><mxPoint x="1253" y="935"/><mxPoint x="1253" y="500"/><mxPoint x="1178" y="500"/></Array></mxGeometry></mxCell><mxCell id="e56" value="SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6C8EBF;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n13" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n57" value="1" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="112" y="478" width="22" height="22" as="geometry"/></mxCell><mxCell id="n58" value="2" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="352" y="640" width="22" height="22" as="geometry"/></mxCell><mxCell id="n59" value="3" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="678" width="22" height="22" as="geometry"/></mxCell><mxCell id="n60" value="4" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="402" width="22" height="22" as="geometry"/></mxCell><mxCell id="n61" value="5" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="295" width="22" height="22" as="geometry"/></mxCell><mxCell id="n62" value="6" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="442" width="22" height="22" as="geometry"/></mxCell><mxCell id="n63" value="7" style="ellipse;html=1;fillColor=#3B5BDB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="484" width="22" height="22" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;One run, step by step&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; The browser submits a company through the proxy.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; The Next.js API route checks the 7-day cache and rate limit.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; It inserts the run as the signed-in user; a trigger fans out one task per agent.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; The worker claims tasks with FOR UPDATE SKIP LOCKED.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Agents search, fetch public pages and call the LLM to extract.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Every finding is written as evidence, then merged and scored.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Realtime streams each row back to every open browser." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="650" y="1000" width="480" height="140" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4D4D4D&#x27;&gt;━━&lt;/font&gt; request and data path &amp;nbsp; &lt;font color=&#x27;#7C3AED&#x27;&gt;━━&lt;/font&gt; Realtime push &amp;nbsp; &lt;font color=&#x27;#6C8EBF&#x27;&gt;╍╍&lt;/font&gt; setup and admin&lt;br&gt;&lt;br&gt;Only port 80 on the ECS is public. The ECS reaches the&lt;br&gt;API gateway and Postgres on private addresses, so the&lt;br&gt;database needs no public IP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="230" y="1000" width="400" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
